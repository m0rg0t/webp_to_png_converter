{
  "name": "webp_to_png_converter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "tunnel": "vk-tunnel --http-protocol=http --host=localhost --port=5173",
    "deploy": "vite build && vk-miniapps-deploy",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.node.json --noEmit",
    "test": "node --test tests/*.test.mjs && vitest run",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "test:browser": "playwright test",
    "dev:vk-mock": "vite --mode vk-mock"
  },
  "dependencies": {
    "@vkontakte/icons": "^3.74.0",
    "@vkontakte/vk-bridge": "^3.0.2",
    "@vkontakte/vk-bridge-react": "^2.0.1",
    "@vkontakte/vk-mini-apps-router": "^1.8.6",
    "@vkontakte/vkui": "^8.4.1",
    "file-saver": "^2.0.5",
    "jszip": "^3.10.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/file-saver": "^2.0.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-legacy": "^8.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "@vkontakte/vk-miniapps-deploy": "^1.0.3",
    "@vkontakte/vk-tunnel": "^0.2.10",
    "eruda": "^3.4.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "terser": "^5.51.2",
    "typescript": "~6.0.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "jsdom": "^30.1.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/dom": "^10.4.2",
    "@eslint/js": "^10.0.1",
    "typescript-eslint": "^8.71.0",
    "globals": "^17.13.0",
    "@types/node": "^24.19.1"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
}
